{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Forge - pluggable enterprise agent backend framework",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch apps/api/src/server.ts",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "start": "tsx apps/api/src/server.ts",
    "worker": "tsx apps/worker/src/main.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "FORGE_ALLOW_RESET=true tsx scripts/reset.ts && pnpm db:migrate && pnpm db:seed",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit",
    "dev:worker": "tsx watch apps/worker/src/main.ts",
    "start:worker": "tsx apps/worker/src/main.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:sso": "tsx scripts/sso-smoke.ts",
    "mock:services": "node services/mock-mcp/server.mjs",
    "smoke:edit": "tsx scripts/edit-smoke.ts",
    "smoke:isolated": "tsx scripts/smoke-isolated.ts",
    "dev:console": "pnpm --filter @forge/console dev",
    "build:console": "pnpm --filter @forge/console build",
    "typecheck:console": "pnpm --filter @forge/console typecheck"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "ajv": "^8.17.1",
    "cron-parser": "^5.0.4",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jose": "^6.0.8",
    "mysql2": "^3.12.0",
    "pino": "^9.6.0",
    "ulid": "^2.3.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "concurrently": "^9.1.2",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
