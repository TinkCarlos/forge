# NODE_ENV must be set explicitly. Only "development" or "test" allow the built-in dev secret defaults, insecure
# session cookies, SSO_MODE other than required and db:reset. Unset or any other value is treated like production.
NODE_ENV=development
PORT=3100
HOST=0.0.0.0
FORGE_PUBLIC_URL=http://localhost:3100
# DATABASE_URL is required in every environment (no built-in default). Replace USER / CHANGE_ME with your own.
DATABASE_URL=mysql://USER:CHANGE_ME@127.0.0.1:3306/forge_dev
FORGE_MASTER_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# Optional: private regular file, owned by this process user, mode 0600; see docs/06-operations/secrets.md
# FORGE_MASTER_KEYRING_FILE=/etc/forge/master-keyring.json
SESSION_SECRET=forge-dev-session-secret-change-me
API_KEY_PEPPER=forge-dev-api-key-pepper-change-me
FORGE_ADMIN_EMAIL=admin@forge.local
FORGE_ADMIN_PASSWORD=change-me-now
FORGE_ADMIN_NAME=Platform Admin
ALLOW_LOCAL_LOGIN=true
EMBEDDED_WORKER=true
WORKER_POLL_MS=1000
SCHEDULER_POLL_MS=15000
MAX_CONCURRENT_RUNS=2
LEASE_TTL_SECONDS=30
MODEL_MAX_ATTEMPTS=2
TOOL_MAX_ATTEMPTS=2
DEFAULT_MAX_CONTEXT_TOKENS=8000
DEFAULT_MAX_PARALLEL_TOOLS=4
MAX_RUN_STEPS=8
DEFAULT_MAX_COST_USD=1
# Deprecated: no longer bypasses the outbound guard; use OUTBOUND_ALLOWLIST.
TOOL_ALLOW_PRIVATE_NETWORK=false
# Outbound allowlist (SSRF guard): comma separated EXACT host:port entries that may be private/loopback,
# IPv6 as [addr]:port. No wildcards, CIDR or bare hosts (an invalid entry stops startup). Empty = block all
# private / loopback / metadata targets. A 302 or DNS answer to any other private address is still blocked.
# A privately hosted OIDC IdP MUST be listed here (e.g. sso.corp.internal:443), otherwise SSO login fails.
# Example for the local mock services:
# OUTBOUND_ALLOWLIST=127.0.0.1:8090
OUTBOUND_ALLOWLIST=
MCP_TIMEOUT_MS=30000
LOG_LEVEL=info
SSO_MODE=optional
SSO_TOKEN_VALIDATION_MODE=oidc
SSO_ROLE_MAPPING_REQUIRED=true
# OIDC (fill after Agent admin provides values)
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3100/auth/oidc/callback
# OIDC_AUDIENCE=
# Tests (OPS-026): `pnpm test` only uses TEST_DATABASE_URL (never DATABASE_URL above); the database name must end
# with _test (no bypass).
# TEST_DATABASE_URL=mysql://USER:CHANGE_ME@127.0.0.1:3306/forge_test
# db:migrate / db:seed / reset on a database not ending with _test or _ux require --confirm-db=<database name>,
# e.g. pnpm db:migrate --confirm-db=forge

# Agent Connector (keep switches false until approved)
AGENT_CONNECTOR_ENABLED=false
AGENT_CONNECTOR_INBOUND_ENABLED=false
AGENT_CONNECTOR_OUTBOUND_ENABLED=false
AGENT_CONNECTOR_LEGACY_FALLBACK_ENABLED=false
AGENT_CONNECTOR_ENVIRONMENT=test
