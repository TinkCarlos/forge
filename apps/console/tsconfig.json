{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@forge/sdk/messages": ["../../packages/sdk/src/message-client.ts"],
      "@forge/sdk/jobs": ["../../packages/sdk/src/job-client.ts"],
      "@forge/core/ids": [
        "../../packages/core/src/ids.ts"
      ],
      "@forge/core/sso-error-codes": [
        "../../packages/core/src/sso-error-codes.ts"
      ]
    },
    "types": [
      "vite/client",
      "node"
    ],
    "noUnusedLocals": true
  },
  "include": [
    "src",
    "vite.config.ts",
    "vite-plugins"
  ]
}